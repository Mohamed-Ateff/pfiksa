# Your MongoDB Connection String
# Get this from MongoDB Atlas after Step 1
MONGODB_URI=mongodb+srv://admin:PASSWORD@cluster0.xxxxx.mongodb.net/employee-reports?retryWrites=true&w=majority

# JWT Secret for authentication
JWT_SECRET=your_secure_jwt_secret_key_here_change_in_production

# Server port
PORT=5000

# Node environment
NODE_ENV=production

# CORS origins
CORS_ORIGIN=https://your-railway-app-url.up.railway.app
