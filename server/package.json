{
  "name": "employee-boss-reports-server",
  "version": "1.0.0",
  "description": "Backend API for Employee-Manager Reporting System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "backup:create": "node backupManager.js create",
    "backup:restore": "node backupManager.js restore",
    "backup:daily": "node -e \"(async () => { const bm = require('./backupManager'); setInterval(() => bm.createBackup().catch(console.error), 86400000); console.log('Daily backup running...'); })()\"",
    "test": "echo \\\"Error: no test specified\\\" && exit 1"
  },
  "keywords": [
    "express",
    "mongodb",
    "reporting"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb-memory-server": "^9.1.6",
    "mongoose": "^7.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
